# Optional: Neon / Postgres connection string.
# When unset, Mallanet Verify uses an in-memory store with the demo volunteer.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optional: Croma organization API key (https://platform.usecroma.com).
# When unset, Croma-backed checks return graceful "skipped" results.
# CROMA_API_KEY=croma_live_...

# Optional override (default https://api.croma.run)
# CROMA_BASE_URL=https://api.croma.run
