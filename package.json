{
  "name": "mallanet-verify",
  "version": "1.0.0",
  "description": "Mallanet Verify — MCP server for NGO volunteer integrity checks (Croma + declared data)",
  "type": "module",
  "license": "MIT",
  "author": "jseramn",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mallanet-verify": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mallanet",
    "mcp",
    "volunteer",
    "verification",
    "croma",
    "colombia"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
